{
  "redirects": [
    {
      "source": "/",
      "destination": "/connexion",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/connexion",
      "permanent": false
    },
    {
      "source": "/login.html",
      "destination": "/connexion",
      "permanent": false
    },
    {
      "source": "/signup.html",
      "destination": "/inscription",
      "permanent": false
    },
    {
      "source": "/app.html",
      "destination": "/connexion",
      "permanent": false
    },
    {
      "source": "/offres.html",
      "destination": "/offres",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/connexion",
      "destination": "/app.html"
    },
    {
      "source": "/welcome",
      "destination": "/app.html"
    },
    {
      "source": "/inscription",
      "destination": "/signup.html"
    },
    {
      "source": "/offres",
      "destination": "/offres.html"
    },
    {
      "source": "/:page(dashboard|backtesting|journal|strategies|calendar|berich|school|account|admin-members|educator|backtest-add|backtest-view|strategy-example|vps-guide|connect)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        }
      ]
    }
  ]
}
